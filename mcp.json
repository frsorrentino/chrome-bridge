{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chrome-bridge": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--prefix",
        "${PLUGIN_DATA}",
        "-y",
        "chrome-bridge-mcp@1.23.0"
      ],
      "env": {
        "CHROME_BRIDGE_CAPS": "all"
      }
    }
  }
}
