t.items) {\\n    list.insertAdjacentHTML('beforeend', `<li>${item.name}<span>${item.price}</span></li>`);\\n  }\\n}\\n\\nloadCart().catch((err) => console.error('Cart failed to load:', err));\\n\"}"}]}
